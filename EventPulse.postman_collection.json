{
  "info": {
    "name": "EventPulse API",
    "description": "Complete EventPulse review collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://eyouth-30912060106928-event-pulse.vercel.app"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "eventId",
      "value": ""
    },
    {
      "key": "registrationId",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Overview",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/"
      }
    },
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register attendee",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Review User\",\"email\":\"review.user@example.com\",\"password\":\"Password123!\"}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (pm.response.code === 201 && data.data && data.data.token) {",
                  "    pm.collectionVariables.set('token', data.data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"admin@eventpulse.local\",\"password\":\"ChangeMe123!\"}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (pm.response.code === 200 && data.data && data.data.token) {",
                  "    pm.collectionVariables.set('token', data.data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/auth/me"
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "List categories",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/categories"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (pm.response.code === 200 && data.data && data.data.length > 0) {",
                  "    pm.collectionVariables.set('categoryId', data.data[0]._id);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "List all events",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/events"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (pm.response.code === 200 && data.data && data.data.length > 0) {",
                  "    pm.collectionVariables.set('eventId', data.data[0]._id);",
                  "    const cat = data.data[0].category;",
                  "    if (cat && cat._id) pm.collectionVariables.set('categoryId', cat._id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Combined filters, pagination and search",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/events?city=Cairo&search=Summit&startDate=2026-01-01&endDate=2028-12-31&sort=popular&page=1&limit=5"
          }
        },
        {
          "name": "Create event (admin)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Review Event\",\"description\":\"Created during API review\",\"date\":\"2027-06-01T12:00:00Z\",\"city\":\"Cairo\",\"capacity\":50,\"category\":\"{{categoryId}}\"}"
            },
            "url": "{{baseUrl}}/api/events"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (pm.response.code === 201 && data.data && data.data._id) {",
                  "    pm.collectionVariables.set('eventId', data.data._id);",
                  "    const cat = data.data.category;",
                  "    if (cat && cat._id) pm.collectionVariables.set('categoryId', cat._id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Show event",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/events/{{eventId}}"
          }
        },
        {
          "name": "Update event (admin)",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"capacity\":60}"
            },
            "url": "{{baseUrl}}/api/events/{{eventId}}"
          }
        },
        {
          "name": "Delete event (admin)",
          "request": {
            "method": "DELETE",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/events/{{eventId}}"
          }
        }
      ]
    },
    {
      "name": "Registrations",
      "item": [
        {
          "name": "Register for event",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/registrations/events/{{eventId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (pm.response.code === 201 && data.data && data.data._id) {",
                  "    pm.collectionVariables.set('registrationId', data.data._id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "My registrations",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/registrations"
          }
        },
        {
          "name": "Cancel own registration",
          "request": {
            "method": "DELETE",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/registrations/{{registrationId}}"
          }
        }
      ]
    },
    {
      "name": "Announcements",
      "item": [
        {
          "name": "Announcement history",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/events/{{eventId}}/messages"
          }
        },
        {
          "name": "Create and broadcast announcement (admin)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"text\":\"Event starts in 15 minutes\"}"
            },
            "url": "{{baseUrl}}/api/events/{{eventId}}/messages"
          }
        }
      ]
    }
  ]
}